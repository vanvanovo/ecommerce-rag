# 应用容器部署用（copy .env.app.example .env 后填真实值）
# 注意：容器内主机名用容器名，不是 127.0.0.1；端口用容器端口，不是宿主映射端口

# 应用对外端口
APP_PORT=8080

# MySQL（容器网络内 3306）
MYSQL_HOST=ecom-mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=ecommerce_qa

# Redis
REDIS_HOST=ecom-redis
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

# Milvus
MILVUS_HOST=ecom-milvus
MILVUS_PORT=19530
MILVUS_DATABASE_NAME=ecom
MILVUS_COLLECTION_NAME=ecom_rag

# LLM（必填）
DASHSCOPE_API_KEY=sk-你的百炼Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 模型设备（auto/cpu/cuda）
MODEL_DEVICE=auto

# 应用配置
VALID_SOURCES=["手机", "电脑", "平板", "售后政策", "操作指南"]
CUSTOMER_SERVICE_PHONE=400-000-0000
